  "collectionBlockers": [
    {
      "id": "VIS-001",
      "severity": "release-blocking",
      "title": "Reference-faithful geometry remains unproven",
      "finding": "The fleet has varied primitives but still reads as a repeated simplified slab-hull/superstructure vocabulary in the collection sheet; all 20 draft distinctive-features checks fail.",
      "requiredAction": "Refine hulls, glazing, rooflines, decks and model-specific features against each reference dossier, then re-review canonical views."
    },
    {
      "id": "VIS-002",
      "severity": "release-blocking",
      "title": "Room cutaway rule is applied, but interiors remain blockout-level",
      "finding": "The shared two-side-wall cutaway rule is verified for all 111 current room frames across all 20 room sets. The resulting images are still not publication-ready: most rooms remain simplified bed/sofa/partition assemblies in shallow or open shells, with residual opaque forward/roof/bulkhead occlusion and tight diagonal framing in several views. V55 saloon remains furniture-like rather than a convincing deck-specific interior. All 20 furnished-room, intersection, floating-fitting, seam, camera and physical-support checks remain draft failures.",
      "requiredAction": "Keep the shared rule, then complete each room shell, bulkhead, joinery, fixtures, machinery and physical supports; tune camera distance and aim per room until every cutaway is readable without residual occlusion. Repeat the independent furnished-room, intersection, seam, support and camera checks."
    },
    {
      "id": "VIS-003",
      "severity": "release-blocking",
      "title": "Material payloads remain visually insufficient",
      "finding": "All 84 GLBs contain authored 128x128 texture/image payloads, but the current exterior and room sheets still read largely as flat color-block treatments with weak model-specific material differentiation. The synchronized draft records fail textures and materials-in-all-views for all 20.",
      "requiredAction": "Apply model-appropriate, sufficiently resolved materials and demonstrate consistent legibility across every canonical exterior, room, deck and exploded view."
    },
    {
      "id": "APP-001",
      "severity": "release-blocking",
      "title": "No independent approval exists",
      "finding": "All 20 quality records remain changes-required with reviewer independent-qa-pending. Technical visual reviews are pending, publicationReady is false for all 20, metrics self-review is not QA-approved for all 20, and the same nine draft fail checks remain on every record even though current paths, hashes, luminance and LOD evidence are complete.",
      "requiredAction": "After the visual blockers are fixed, run a new independent QA pass and record explicit approval per selected ID."
    }
  ],
