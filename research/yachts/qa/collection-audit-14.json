  "collectionBlockers": [
    {
      "id": "VIS-001",
      "severity": "release-blocking",
      "title": "Exterior signatures improve differentiation but do not prove reference fidelity",
      "finding": "The 18 refreshed generic sets now show visible family/model cues: the lower V40 treatment, taller F/Y/X arrangements, S sportsbridge treatment and Predator brow/intake variants are distinguishable in the sheet. However, the hulls, glazing, rooflines and deck structures still read as simplified procedural slabs rather than reference-faithful model-specific forms, and all 20 draft distinctive-features checks fail.",
      "requiredAction": "Use the new signatures as a base, then refine hull curvature, sheer/chines, glazing boundaries, roofline transitions, deck geometry and model-specific fittings against each reference dossier before repeating canonical visual review."
    },
    {
      "id": "VIS-002",
      "severity": "release-blocking",
      "title": "Room cutaway rule is applied, but interiors remain blockout-level",
      "finding": "The shared two-side-wall cutaway rule is verified for all 111 current room frames across all 20 room sets. The room sheet remains dominated by simplified beds, sofas, partitions and basic equipment in shallow/open shells, with residual opaque forward/roof/bulkhead occlusion and tight diagonal framing in several views. V55 saloon remains furniture-like rather than a convincing deck-specific interior. All 20 furnished-room, intersection, floating-fitting, seam, camera and physical-support checks remain draft failures.",
      "requiredAction": "Keep the shared rule, then complete each room shell, bulkhead, joinery, fixtures, machinery and physical supports; tune camera distance and aim per room until every cutaway is readable without residual occlusion. Repeat the independent furnished-room, intersection, seam, support and camera checks."
    },
    {
      "id": "VIS-003",
      "severity": "release-blocking",
      "title": "Brand materials are present but remain visually insufficient",
      "finding": "The refreshed masters distinguish Princess and Sunseeker gelcoat/glazing palettes and all 84 GLBs contain authored 128x128 texture/image payloads, but the renders still read largely as flat color-block treatments with low-detail glazing, teak and interior materials. The synchronized draft records fail textures and materials-in-all-views for all 20.",
      "requiredAction": "Increase material resolution and variation, resolve glazing/gelcoat/teak response and demonstrate model-appropriate material legibility across every canonical exterior, room, deck and exploded view."
    },
    {
      "id": "APP-001",
      "severity": "release-blocking",
      "title": "No independent approval exists",
      "finding": "All 20 quality records remain changes-required with reviewer independent-qa-pending. Technical visual reviews are pending, publicationReady is false for all 20, metrics self-review is not QA-approved for all 20, and the same nine draft fail checks remain on every record even though current paths, hashes, luminance and LOD evidence are complete.",
      "requiredAction": "After the visual blockers are fixed, run a new independent QA pass and record explicit approval per selected ID."
    }
  ],
